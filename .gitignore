# dependencies
/node_modules

# next.js
/.next/
/out/
next-env.d.ts

# Social cards, drawn from lib/og-cards.json by scripts/gen-og.mjs on every
# `pnpm build` and `pnpm dev`. Generated rather than committed because there
# is now nothing manual about producing them -- the fonts are vendored under
# assets/fonts/, so any machine can draw a card that matches the copy. The
# lockups under public/brand/ stay committed for the opposite reason: they
# need a macOS system font to regenerate.
#
# The deploy job checks these exist in out/ before publishing, so a build that
# skipped the prebuild hook fails there rather than shipping a site whose
# every share preview 404s.
/public/og/*.png

# misc
.DS_Store
*.pem
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo

# Stella agent workspace. The root `.stella/` is per-workspace scratch
# (sessions, exports, private evidence) and stays ignored — with one tracked
# exception: `commands/`. A custom slash command only steers a teammate's
# session if it travels with the repository, so commands are reviewed through
# the same pull requests as the code. Mirrors the exception macanderson/stella
# makes for `.stella/rules/`.
!/.stella/
/.stella/*
# Commands are opt-in, one command per line, rather than a blanket negation:
# `.stella/commands/` is also where locally-generated scratch commands land,
# and a command only belongs in review if someone meant it to travel. Four
# lines are required, in this order -- git cannot re-include a file whose
# parent directory is excluded, so dropping the first makes the rest inert.
!/.stella/commands/
/.stella/commands/*
!/.stella/commands/triage-sweep.md
!/.stella/commands/triage-sweep.toml

# Verification artifacts — Lighthouse reports, screenshots, command output
# captured to prove a change works. They are evidence for the pull request that
# produced them, not source: regenerating them is a command, and a Lighthouse
# JSON for one commit is noise against every later one. Committing a set cost
# 7.4 MB across ten files, permanently, in a repository whose entire tracked
# source is smaller than that. Keep them local and link them from the PR.
verifications/
